{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=server.ts --watch-path=server --disable-warning=ExperimentalWarning --import tsx server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server.ts",
    "prod": "node -e \"process.env.NODE_ENV='production'; require('child_process').execSync('npm run start',{stdio:'inherit',env:process.env})\"",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test:routes": "node --import tsx tests/routes.smoke.tsx",
    "test:utils": "node --import tsx tests/utils.smoke.ts",
    "test:seo": "node --import tsx tests/seo.smoke.ts",
    "test:pagination": "node --import tsx tests/pagination.smoke.ts",
    "test:warranty": "node --import tsx tests/warranty.smoke.ts",
    "test:warranty-ui": "node --import tsx tests/warrantyUi.smoke.ts",
    "test:cms-warranty": "node --import tsx tests/warrantyCms.smoke.tsx",
    "test:quotes": "node --import tsx tests/quote.smoke.ts",
    "test:quote-ui": "node --import tsx tests/quoteUi.smoke.ts",
    "test:cms-quotes": "node --import tsx tests/quotesCms.smoke.tsx",
    "test:coupons": "node --import tsx tests/coupon.smoke.ts",
    "test:shipping": "node --import tsx tests/shipping.smoke.ts",
    "test:campaigns": "node --import tsx tests/campaign.smoke.ts",
    "test:commerce-ui": "node --import tsx tests/commerceUi.smoke.ts",
    "test:cms-commerce": "node --import tsx tests/commerceCms.smoke.tsx",
    "test:catalog": "node --import tsx tests/catalog.smoke.ts",
    "test:catalog-ui": "node --import tsx tests/catalogUi.smoke.tsx",
    "test:attendance-ui": "node --import tsx tests/attendanceUi.smoke.tsx",
    "test:web-design-ui": "node --import tsx tests/webDesignUi.smoke.tsx",
    "test:services": "node --import tsx tests/service.smoke.ts",
    "test:search": "node --import tsx tests/search.smoke.ts",
    "test:search-ui": "node --import tsx tests/searchUi.smoke.tsx",
    "test:admin-login": "node --import tsx tests/adminLogin.smoke.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mssql": "^12.7.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "node-gyp-build": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.5.0"
  }
}
