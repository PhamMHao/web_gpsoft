# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Tên miền công khai của site (P0.2) — server dùng để sinh sitemap.xml & robots.txt.
# VITE_APP_URL: Cùng giá trị, client dùng để dựng canonical/OG (Vite chỉ expose biến tiền tố VITE_*).
APP_URL="http://localhost:3100"
VITE_APP_URL="http://localhost:3100"

# DATABASE
# DB_DRIVER: "sqlite" (default) | "mysql" (requires: npm install mysql2) | "mssql" (requires: npm install mssql)
DB_DRIVER="sqlite"
# SQLITE_FILE: Path to the SQLite database file (default: ./data/gpsoft.sqlite)
# SQLITE_FILE="./data/gpsoft.sqlite"

# MySQL connection (used when DB_DRIVER="mysql")
# MYSQL_HOST="127.0.0.1"
# MYSQL_PORT="3306"
# MYSQL_USER="root"
# MYSQL_PASSWORD=""
# MYSQL_DATABASE="gpsoft"

# Microsoft SQL Server connection (used when DB_DRIVER="mssql")
# The database must already exist and the login must be allowed to create tables.
# MSSQL_SERVER="localhost"              # alias: MSSQL_HOST
# MSSQL_PORT="1433"                     # ignored when MSSQL_INSTANCE is set
# MSSQL_INSTANCE="SQLEXPRESS"           # named instance, e.g. "localhost\SQLEXPRESS"
# MSSQL_DATABASE="gpsoft"
#
# --- MSSQL_AUTH: "windows" (default) | "sql" | "ntlm" ---
# "windows" - Windows Integrated Authentication over ODBC using the Windows
#   account that runs the app. No username/password is stored. Requires the
#   "msnodesqlv8" package plus an ODBC driver for SQL Server.
# MSSQL_AUTH="windows"
# MSSQL_ODBC_DRIVER="ODBC Driver 17 for SQL Server"   # "ODBC Driver 18 for SQL Server", "SQL Server Native Client 11.0", ...
# MSSQL_ODBC_CONNECTION_STRING=""       # optional: a full ODBC string; overrides the settings above
# NOTE: "windows" mode needs the "msnodesqlv8" package (listed under
# optionalDependencies and already present in node_modules). Reinstalling it must
# be done from a folder whose path contains no "&" - cmd.exe splits the
# node_modules/.bin path on "&", which breaks the package's install script.
#
# "sql" - SQL Server login over TDS (tedious).
# MSSQL_AUTH="sql"
# MSSQL_USER="sa"
# MSSQL_PASSWORD="YourStrong!Passw0rd"
#
# "ntlm" - a Windows account given explicitly.
# MSSQL_AUTH="ntlm"
# MSSQL_USER="DESKTOP-K6PQP6U\Admin"    # or set MSSQL_DOMAIN + plain user name
# MSSQL_DOMAIN="DESKTOP-K6PQP6U"
# MSSQL_PASSWORD="windows-password"
#
# MSSQL_TRUSTED_CONNECTION="true"       # shortcut for MSSQL_AUTH="windows"
# MSSQL_ENCRYPT="false"                 # set "true" for Azure SQL
# MSSQL_TRUST_SERVER_CERTIFICATE="true" # keep "true" for self-signed local certificates
# MSSQL_TDS_VERSION="7_3_B"             # SQL Server 2008/2008 R2 on the "sql"/"ntlm" paths
